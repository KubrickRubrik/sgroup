{
  "name": "beta-fixes",
  "displayName": "beta_fixes",
  "description": "Сообщения канала Discord в правой колонке.",
  "version": "0.1.3",
  "publisher": "easybusy",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:beta.init",
    "onWebviewPanel:beta.panel"
  ],
  "contributes": {
    "commands": [
      {
        "command": "beta.init",
        "title": "init",
        "category": "beta"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "package": "npm run typecheck && node esbuild.js --production && mkdir -p ../../version && vsce package --no-dependencies --allow-missing-repository --skip-license --out ../../version/"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
