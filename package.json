{
  "name": "vgroup",
  "displayName": "VGroup",
  "description": "Mark files and folders with markers to keep semantically related items side by side, regardless of alphabetical order.",
  "version": "2.0.6",
  "publisher": "easybusy",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "explorer",
    "markers",
    "tags",
    "groups",
    "bookmarks"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:vgroupMapPanel"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "vgroupPanel",
          "title": "VGroup",
          "icon": "media/map-icon.svg"
        }
      ]
    },
    "views": {
      "vgroupPanel": [
        {
          "type": "webview",
          "id": "vgroupMapBottom",
          "name": "VGroup",
          "icon": "media/map-icon.svg"
        }
      ],
      "explorer": [
        {
          "type": "webview",
          "id": "vgroupMap",
          "name": "VGroup",
          "visibility": "visible",
          "icon": "media/map-icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "vgroup.assign",
        "title": "Mark…",
        "category": "VGroup",
        "icon": "$(tag)"
      },
      {
        "command": "vgroup.markClass",
        "title": "Mark Class…",
        "category": "VGroup",
        "icon": "$(symbol-class)"
      },
      {
        "command": "vgroup.markClassManual",
        "title": "Mark Class Manually…",
        "category": "VGroup",
        "icon": "$(symbol-class)"
      },
      {
        "command": "vgroup.setAlias",
        "title": "Set Alias…",
        "category": "VGroup",
        "icon": "$(whole-word)"
      },
      {
        "command": "vgroup.clearAlias",
        "title": "Clear Alias",
        "category": "VGroup"
      },
      {
        "command": "vgroup.openClass",
        "title": "Open Class",
        "category": "VGroup",
        "icon": "$(go-to-file)"
      },
      {
        "command": "vgroup.openItem",
        "title": "Open Item",
        "category": "VGroup",
        "icon": "$(files)"
      },
      {
        "command": "vgroup.openFull",
        "title": "Open Full",
        "category": "VGroup",
        "icon": "$(folder-opened)"
      },
      {
        "command": "vgroup.unassign",
        "title": "Remove Marker",
        "category": "VGroup",
        "icon": "$(close)"
      },
      {
        "command": "vgroup.unassignFromExplorer",
        "title": "Remove Markers",
        "category": "VGroup"
      },
      {
        "command": "vgroup.rename",
        "title": "Rename…",
        "category": "VGroup",
        "icon": "$(edit)"
      },
      {
        "command": "vgroup.reveal",
        "title": "Reveal in Explorer View",
        "category": "VGroup"
      },
      {
        "command": "vgroup.relink",
        "title": "Relink to File…",
        "category": "VGroup",
        "icon": "$(link)"
      },
      {
        "command": "vgroup.createMarker",
        "title": "Create Marker",
        "category": "VGroup",
        "icon": "$(add)"
      },
      {
        "command": "vgroup.editMarker",
        "title": "Edit Marker…",
        "category": "VGroup",
        "icon": "$(edit)"
      },
      {
        "command": "vgroup.deleteMarker",
        "title": "Delete Marker",
        "category": "VGroup",
        "icon": "$(trash)"
      },
      {
        "command": "vgroup.moveMarkerUp",
        "title": "Move Up",
        "category": "VGroup",
        "icon": "$(arrow-up)"
      },
      {
        "command": "vgroup.moveMarkerDown",
        "title": "Move Down",
        "category": "VGroup",
        "icon": "$(arrow-down)"
      },
      {
        "command": "vgroup.openConfig",
        "title": "Open Markers File",
        "category": "VGroup",
        "icon": "$(json)"
      },
      {
        "command": "vgroup.openSettings",
        "title": "Open Settings",
        "category": "VGroup",
        "icon": "$(gear)"
      },
      {
        "command": "vgroup.vsix",
        "title": "Package / Install VSIX…",
        "category": "VGroup",
        "icon": "$(package)"
      },
      {
        "command": "vgroup.refresh",
        "title": "Refresh",
        "category": "VGroup",
        "icon": "$(refresh)"
      },
      {
        "command": "vgroup.openMap",
        "title": "Open Map",
        "category": "VGroup",
        "icon": "$(map)"
      },
      {
        "command": "vgroup.map.toggleLayout",
        "title": "Toggle Map Layout (Chips / List)",
        "category": "VGroup",
        "icon": "$(list-flat)"
      },
      {
        "command": "vgroup.map.move",
        "title": "Move Map…",
        "category": "VGroup",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "vgroup.map.toggleColumn",
        "title": "Toggle Map Column Beside Explorer",
        "category": "VGroup",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "vgroup.map.openBottom",
        "title": "Open Map in Bottom Panel",
        "category": "VGroup",
        "icon": "$(layout-panel)"
      },
      {
        "command": "vgroup.changeColor",
        "title": "Change Color…",
        "category": "VGroup",
        "icon": "$(symbol-color)"
      },
      {
        "command": "vgroup.changeIcon",
        "title": "Change Icon…",
        "category": "VGroup",
        "icon": "$(smiley)"
      },
      {
        "command": "vgroup.changeBadge",
        "title": "Change Badge…",
        "category": "VGroup",
        "icon": "$(tag)"
      },
      {
        "command": "vgroup.map.groups.flow",
        "title": "Groups: Flow — click for 1 column",
        "category": "VGroup",
        "icon": "$(word-wrap)"
      },
      {
        "command": "vgroup.map.groups.1",
        "title": "Groups: 1 column — click for 2 columns",
        "category": "VGroup",
        "icon": "$(list-flat)"
      },
      {
        "command": "vgroup.map.groups.2",
        "title": "Groups: 2 columns — click for 3 columns",
        "category": "VGroup",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "vgroup.map.groups.3",
        "title": "Groups: 3 columns — click for flow",
        "category": "VGroup",
        "icon": "$(table)"
      },
      {
        "command": "vgroup.setColumns.flow",
        "title": "Flow",
        "category": "VGroup"
      },
      {
        "command": "vgroup.setColumns.2",
        "title": "2 Columns",
        "category": "VGroup"
      },
      {
        "command": "vgroup.setColumns.3",
        "title": "3 Columns",
        "category": "VGroup"
      },
      {
        "command": "vgroup.createSubgroup",
        "title": "New Subgroup…",
        "category": "VGroup",
        "icon": "$(new-folder)"
      },
      {
        "command": "vgroup.unnestMarker",
        "title": "Move Up a Level",
        "category": "VGroup",
        "icon": "$(arrow-up)"
      }
    ],
    "submenus": [
      {
        "id": "vgroup.columns",
        "label": "Columns"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "vgroup.assign",
          "group": "7_modification@90"
        },
        {
          "command": "vgroup.markClassManual",
          "when": "!explorerResourceIsFolder",
          "group": "7_modification@90.5"
        },
        {
          "command": "vgroup.unassignFromExplorer",
          "group": "7_modification@91"
        }
      ],
      "editor/context": [
        {
          "command": "vgroup.markClass",
          "group": "7_modification@90"
        }
      ],
      "view/title": [
        {
          "command": "vgroup.refresh",
          "when": "view == vgroupMap || view == vgroupMapBottom",
          "group": "more@1"
        },
        {
          "command": "vgroup.openConfig",
          "when": "view == vgroupMap || view == vgroupMapBottom",
          "group": "more@2"
        },
        {
          "command": "vgroup.openSettings",
          "when": "view == vgroupMap || view == vgroupMapBottom",
          "group": "more@3"
        },
        {
          "command": "vgroup.map.toggleLayout",
          "when": "view == vgroupMap || view == vgroupMapBottom",
          "group": "navigation@0"
        },
        {
          "command": "vgroup.createMarker",
          "when": "view == vgroupMap || view == vgroupMapBottom",
          "group": "navigation@2"
        },
        {
          "command": "vgroup.map.openBottom",
          "when": "view == vgroupMap",
          "group": "navigation@8"
        },
        {
          "command": "vgroup.map.toggleColumn",
          "when": "view == vgroupMap",
          "group": "navigation@9"
        },
        {
          "command": "vgroup.map.groups.flow",
          "when": "(view == vgroupMap || view == vgroupMapBottom) && (vgroup.map.groupsLayout == flow || !vgroup.map.groupsLayout)",
          "group": "navigation@1"
        },
        {
          "command": "vgroup.map.groups.1",
          "when": "(view == vgroupMap || view == vgroupMapBottom) && vgroup.map.groupsLayout == 1",
          "group": "navigation@1"
        },
        {
          "command": "vgroup.map.groups.2",
          "when": "(view == vgroupMap || view == vgroupMapBottom) && vgroup.map.groupsLayout == 2",
          "group": "navigation@1"
        },
        {
          "command": "vgroup.map.groups.3",
          "when": "(view == vgroupMap || view == vgroupMapBottom) && vgroup.map.groupsLayout == 3",
          "group": "navigation@1"
        }
      ],
      "webview/context": [
        {
          "command": "vgroup.reveal",
          "when": "webviewId =~ /^vgroupMap(Panel|Bottom)?$/ && webviewSection == 'item'",
          "group": "navigation@1"
        },
        {
          "command": "vgroup.openClass",
          "when": "webviewId =~ /^vgroupMap(Panel|Bottom)?$/ && webviewSection == 'class'",
          "group": "navigation@1"
        },
        {
          "command": "vgroup.reveal",
          "when": "webviewId =~ /^vgroupMap(Panel|Bottom)?$/ && webviewSection == 'class'",
          "group": "navigation@2"
        },
        {
          "command": "vgroup.openItem",
          "when": "webviewId =~ /^vgroupMap(Panel|Bottom)?$/ && webviewSection == 'marker'",
          "group": "navigation@1"
        },
        {
          "command": "vgroup.openFull",
          "when": "webviewId =~ /^vgroupMap(Panel|Bottom)?$/ && webviewSection == 'marker'",
          "group": "navigation@2"
        },
        {
          "command": "vgroup.openItem",
          "when": "webviewId =~ /^vgroupMap(Panel|Bottom)?$/ && webviewSection == 'item' && isDir",
          "group": "navigation@2"
        },
        {
          "command": "vgroup.openFull",
          "when": "webviewId =~ /^vgroupMap(Panel|Bottom)?$/ && webviewSection == 'item' && isDir",
          "group": "navigation@3"
        },
        {
          "command": "vgroup.rename",
          "when": "webviewId =~ /^vgroupMap(Panel|Bottom)?$/ && webviewSection == 'item'",
          "group": "7_modification@1"
        },
        {
          "command": "vgroup.setAlias",
          "when": "webviewId =~ /^vgroupMap(Panel|Bottom)?$/ && webviewSection =~ /^(item|class|missingClass)$/",
          "group": "7_modification@1.5"
        },
        {
          "command": "vgroup.clearAlias",
          "when": "webviewId =~ /^vgroupMap(Panel|Bottom)?$/ && webviewSection =~ /^(item|class|missingClass)$/ && hasAlias",
          "group": "7_modification@1.6"
        },
        {
          "command": "vgroup.relink",
          "when": "webviewId =~ /^vgroupMap(Panel|Bottom)?$/ && webviewSection == 'missing'",
          "group": "7_modification@2"
        },
        {
          "command": "vgroup.unassign",
          "when": "webviewId =~ /^vgroupMap(Panel|Bottom)?$/ && webviewSection =~ /^(item|missing|class|missingClass)$/",
          "group": "7_modification@3"
        },
        {
          "command": "vgroup.editMarker",
          "when": "webviewId =~ /^vgroupMap(Panel|Bottom)?$/ && webviewSection == 'marker'",
          "group": "1_marker@1"
        },
        {
          "command": "vgroup.setAlias",
          "when": "webviewId =~ /^vgroupMap(Panel|Bottom)?$/ && webviewSection == 'marker'",
          "group": "1_marker@1.5"
        },
        {
          "command": "vgroup.clearAlias",
          "when": "webviewId =~ /^vgroupMap(Panel|Bottom)?$/ && webviewSection == 'marker' && hasAlias",
          "group": "1_marker@1.6"
        },
        {
          "command": "vgroup.moveMarkerUp",
          "when": "webviewId =~ /^vgroupMap(Panel|Bottom)?$/ && webviewSection == 'marker'",
          "group": "1_marker@6"
        },
        {
          "command": "vgroup.moveMarkerDown",
          "when": "webviewId =~ /^vgroupMap(Panel|Bottom)?$/ && webviewSection == 'marker'",
          "group": "1_marker@7"
        },
        {
          "command": "vgroup.deleteMarker",
          "when": "webviewId =~ /^vgroupMap(Panel|Bottom)?$/ && webviewSection == 'marker'",
          "group": "2_danger@1"
        },
        {
          "command": "vgroup.changeColor",
          "when": "webviewId =~ /^vgroupMap(Panel|Bottom)?$/ && webviewSection == 'marker'",
          "group": "1_marker@3"
        },
        {
          "command": "vgroup.changeIcon",
          "when": "webviewId =~ /^vgroupMap(Panel|Bottom)?$/ && webviewSection == 'marker'",
          "group": "1_marker@4"
        },
        {
          "command": "vgroup.changeBadge",
          "when": "webviewId =~ /^vgroupMap(Panel|Bottom)?$/ && webviewSection == 'marker'",
          "group": "1_marker@5"
        },
        {
          "submenu": "vgroup.columns",
          "when": "webviewId =~ /^vgroupMap(Panel|Bottom)?$/ && webviewSection == 'marker'",
          "group": "1_marker@5.5"
        },
        {
          "command": "vgroup.createSubgroup",
          "when": "webviewId =~ /^vgroupMap(Panel|Bottom)?$/ && webviewSection == 'marker' && depth < 2",
          "group": "1_marker@2"
        },
        {
          "command": "vgroup.unnestMarker",
          "when": "webviewId =~ /^vgroupMap(Panel|Bottom)?$/ && webviewSection == 'marker' && depth > 0",
          "group": "1_marker@8"
        }
      ],
      "vgroup.columns": [
        {
          "command": "vgroup.setColumns.flow",
          "group": "1_columns@1",
          "toggled": "columns == 'flow'"
        },
        {
          "command": "vgroup.setColumns.2",
          "group": "1_columns@2",
          "toggled": "columns == '2'"
        },
        {
          "command": "vgroup.setColumns.3",
          "group": "1_columns@3",
          "toggled": "columns == '3'"
        }
      ],
      "commandPalette": [
        {
          "command": "vgroup.unassign",
          "when": "false"
        },
        {
          "command": "vgroup.unassignFromExplorer",
          "when": "false"
        },
        {
          "command": "vgroup.rename",
          "when": "false"
        },
        {
          "command": "vgroup.reveal",
          "when": "false"
        },
        {
          "command": "vgroup.relink",
          "when": "false"
        },
        {
          "command": "vgroup.editMarker",
          "when": "false"
        },
        {
          "command": "vgroup.deleteMarker",
          "when": "false"
        },
        {
          "command": "vgroup.moveMarkerUp",
          "when": "false"
        },
        {
          "command": "vgroup.moveMarkerDown",
          "when": "false"
        },
        {
          "command": "vgroup.changeColor",
          "when": "false"
        },
        {
          "command": "vgroup.changeIcon",
          "when": "false"
        },
        {
          "command": "vgroup.changeBadge",
          "when": "false"
        },
        {
          "command": "vgroup.map.groups.flow",
          "when": "false"
        },
        {
          "command": "vgroup.map.groups.1",
          "when": "false"
        },
        {
          "command": "vgroup.map.groups.2",
          "when": "false"
        },
        {
          "command": "vgroup.map.groups.3",
          "when": "false"
        },
        {
          "command": "vgroup.setColumns.flow",
          "when": "false"
        },
        {
          "command": "vgroup.setColumns.2",
          "when": "false"
        },
        {
          "command": "vgroup.setColumns.3",
          "when": "false"
        },
        {
          "command": "vgroup.createSubgroup",
          "when": "false"
        },
        {
          "command": "vgroup.unnestMarker",
          "when": "false"
        },
        {
          "command": "vgroup.setAlias",
          "when": "false"
        },
        {
          "command": "vgroup.clearAlias",
          "when": "false"
        },
        {
          "command": "vgroup.openClass",
          "when": "false"
        },
        {
          "command": "vgroup.openItem",
          "when": "false"
        },
        {
          "command": "vgroup.openFull",
          "when": "false"
        },
        {
          "command": "vgroup.markClassManual",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "vgroup.map.toggleLayout",
          "when": "activeWebviewPanelId == 'vgroupMapPanel'",
          "group": "navigation@0"
        },
        {
          "command": "vgroup.createMarker",
          "when": "activeWebviewPanelId == 'vgroupMapPanel'",
          "group": "navigation@2"
        },
        {
          "command": "vgroup.map.groups.flow",
          "when": "activeWebviewPanelId == 'vgroupMapPanel' && (vgroup.map.groupsLayout == flow || !vgroup.map.groupsLayout)",
          "group": "navigation@1"
        },
        {
          "command": "vgroup.map.groups.1",
          "when": "activeWebviewPanelId == 'vgroupMapPanel' && vgroup.map.groupsLayout == 1",
          "group": "navigation@1"
        },
        {
          "command": "vgroup.map.groups.2",
          "when": "activeWebviewPanelId == 'vgroupMapPanel' && vgroup.map.groupsLayout == 2",
          "group": "navigation@1"
        },
        {
          "command": "vgroup.map.groups.3",
          "when": "activeWebviewPanelId == 'vgroupMapPanel' && vgroup.map.groupsLayout == 3",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "VGroup",
      "properties": {
        "vgroup.map.columnWidth": {
          "type": "number",
          "default": 260,
          "minimum": 120,
          "description": "Width in pixels of the map column opened beside the Explorer (VGroup: Toggle Map Column Beside Explorer)."
        },
        "vgroup.showDecorations": {
          "type": "boolean",
          "default": true,
          "description": "Show marker badges and colors in the standard Explorer."
        }
      }
    },
    "colors": [
      {
        "id": "vgroup.red",
        "description": "VGroup marker color: Red",
