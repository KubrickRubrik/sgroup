{
  "name": "syngroup",
  "displayName": "SynGroup",
  "description": "Mark files and folders with markers to keep semantically related items side by side, regardless of alphabetical order.",
  "version": "4.1.2",
  "publisher": "easybusy",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "explorer",
    "markers",
    "tags",
    "groups",
    "bookmarks"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:syn3MapPanel"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "syn3Panel",
          "title": "SYN3",
          "icon": "media/map-icon.svg"
        }
      ]
    },
    "views": {
      "syn3Panel": [
        {
          "type": "webview",
          "id": "syn3MapBottom",
          "name": "SYN3",
          "contextualTitle": "Explorer",
          "icon": "media/map-icon.svg"
        }
      ],
      "explorer": [
        {
          "type": "webview",
          "id": "syn3Map",
          "name": "SYN3",
          "contextualTitle": "Explorer",
          "visibility": "visible",
          "icon": "media/map-icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "syn3.assign",
        "title": "Mark…",
        "category": "SGroup",
        "icon": "$(tag)"
      },
      {
        "command": "syn3.markClass",
        "title": "Mark Class…",
        "category": "SGroup",
        "icon": "$(symbol-class)"
      },
      {
        "command": "syn3.markClassManual",
        "title": "Mark Class Manually…",
        "category": "SGroup",
        "icon": "$(symbol-class)"
      },
      {
        "command": "syn3.setAlias",
        "title": "Set Alias…",
        "category": "SGroup",
        "icon": "$(whole-word)"
      },
      {
        "command": "syn3.clearAlias",
        "title": "Clear Alias",
        "category": "SGroup"
      },
      {
        "command": "syn3.openClass",
        "title": "Open Class",
        "category": "SGroup",
        "icon": "$(go-to-file)"
      },
      {
        "command": "syn3.openItem",
        "title": "Open Item",
        "category": "SGroup",
        "icon": "$(files)"
      },
      {
        "command": "syn3.openFull",
        "title": "Open Full",
        "category": "SGroup",
        "icon": "$(folder-opened)"
      },
      {
        "command": "syn3.unassign",
        "title": "Remove Marker",
        "category": "SGroup",
        "icon": "$(close)"
      },
      {
        "command": "syn3.unassignFromExplorer",
        "title": "Remove Markers",
        "category": "SGroup"
      },
      {
        "command": "syn3.rename",
        "title": "Rename…",
        "category": "SGroup",
        "icon": "$(edit)"
      },
      {
        "command": "syn3.reveal",
        "title": "Reveal in Explorer View",
        "category": "SGroup"
      },
      {
        "command": "syn3.relink",
        "title": "Relink to File…",
        "category": "SGroup",
        "icon": "$(link)"
      },
      {
        "command": "syn3.createMarker",
        "title": "Create Marker",
        "category": "SGroup",
        "icon": {
          "light": "media/icons/add-light.svg",
          "dark": "media/icons/add-dark.svg"
        }
      },
      {
        "command": "syn3.map.collapseGroups",
        "title": "Свернуть все группы",
        "category": "SGroup",
        "icon": {
          "light": "media/icons/collapse-all-light.svg",
          "dark": "media/icons/collapse-all-dark.svg"
        }
      },
      {
        "command": "syn3.map.expandGroups",
        "title": "Развернуть все группы",
        "category": "SGroup",
        "icon": {
          "light": "media/icons/expand-all-light.svg",
          "dark": "media/icons/expand-all-dark.svg"
        }
      },
      {
        "command": "syn3.editMarker",
        "title": "Edit Marker…",
        "category": "SGroup",
        "icon": "$(edit)"
      },
      {
        "command": "syn3.deleteMarker",
        "title": "Delete Marker",
        "category": "SGroup",
        "icon": "$(trash)"
      },
      {
        "command": "syn3.moveMarkerUp",
        "title": "Move Up",
        "category": "SGroup",
        "icon": "$(arrow-up)"
      },
      {
        "command": "syn3.moveMarkerDown",
        "title": "Move Down",
        "category": "SGroup",
        "icon": "$(arrow-down)"
      },
      {
        "command": "syn3.openConfig",
        "title": "Open Markers File",
        "category": "SGroup",
        "icon": {
          "light": "media/icons/json-light.svg",
          "dark": "media/icons/json-dark.svg"
        }
      },
      {
        "command": "syn3.openSettings",
        "title": "Open Settings",
        "category": "SGroup",
        "icon": {
          "light": "media/icons/gear-light.svg",
          "dark": "media/icons/gear-dark.svg"
        }
      },
      {
        "command": "syn3.vsix",
        "title": "Package / Install VSIX…",
        "category": "SGroup",
        "icon": "$(package)"
      },
      {
        "command": "syn3.refresh",
        "title": "Refresh",
        "category": "SGroup",
        "icon": {
          "light": "media/icons/refresh-light.svg",
          "dark": "media/icons/refresh-dark.svg"
        }
      },
      {
        "command": "syn3.historyBack",
        "title": "Назад",
        "category": "SGroup",
        "icon": {
          "light": "media/icons/arrow-left-light.svg",
          "dark": "media/icons/arrow-left-dark.svg"
        },
        "enablement": "syn3.canUndo"
      },
      {
        "command": "syn3.historyForward",
        "title": "Вперёд",
        "category": "SGroup",
        "icon": {
          "light": "media/icons/arrow-right-light.svg",
          "dark": "media/icons/arrow-right-dark.svg"
        },
        "enablement": "syn3.canRedo"
      },
      {
        "command": "syn3.openMap",
        "title": "Open Map",
        "category": "SGroup",
        "icon": "$(map)"
      },
      {
        "command": "syn3.map.toggleLayout",
        "title": "Toggle Map Layout (Chips / List)",
        "category": "SGroup",
        "icon": {
          "light": "media/icons/list-flat-light.svg",
          "dark": "media/icons/list-flat-dark.svg"
        }
      },
      {
        "command": "syn3.map.move",
        "title": "Move Map…",
        "category": "SGroup",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "syn3.map.toggleColumn",
        "title": "Toggle Map Column Beside Explorer",
        "category": "SGroup",
        "icon": {
          "light": "media/icons/layout-sidebar-left-light.svg",
          "dark": "media/icons/layout-sidebar-left-dark.svg"
        }
      },
      {
        "command": "syn3.map.toggleRight",
        "title": "Toggle Map Column on the Right",
        "category": "SGroup",
        "icon": {
          "light": "media/icons/sidebar-right-light.svg",
          "dark": "media/icons/sidebar-right-dark.svg"
        }
      },
      {
        "command": "syn3.map.openBottom",
        "title": "Toggle Map in Bottom Panel",
        "category": "SGroup",
        "icon": {
          "light": "media/icons/layout-panel-light.svg",
          "dark": "media/icons/layout-panel-dark.svg"
        }
      },
      {
        "command": "syn3.changeColor",
        "title": "Change Color…",
        "category": "SGroup",
        "icon": "$(symbol-color)"
      },
      {
        "command": "syn3.changeIcon",
        "title": "Change Icon…",
        "category": "SGroup",
        "icon": "$(smiley)"
      },
      {
        "command": "syn3.map.groups.flow",
        "title": "Groups: Flow — click for 1 column",
        "category": "SGroup",
        "icon": {
          "light": "media/icons/word-wrap-light.svg",
          "dark": "media/icons/word-wrap-dark.svg"
        }
      },
      {
        "command": "syn3.map.groups.1",
        "title": "Groups: 1 column — click for 2 columns",
        "category": "SGroup",
        "icon": {
          "light": "media/icons/list-flat-light.svg",
          "dark": "media/icons/list-flat-dark.svg"
        }
      },
      {
        "command": "syn3.map.groups.2",
        "title": "Groups: 2 columns — click for 3 columns",
        "category": "SGroup",
        "icon": {
          "light": "media/icons/split-horizontal-light.svg",
          "dark": "media/icons/split-horizontal-dark.svg"
        }
      },
      {
        "command": "syn3.map.groups.3",
        "title": "Groups: 3 columns — click for flow",
        "category": "SGroup",
        "icon": {
          "light": "media/icons/table-light.svg",
          "dark": "media/icons/table-dark.svg"
        }
      },
      {
        "command": "syn3.setColumns.flow",
        "title": "Flow",
        "category": "SGroup"
      },
      {
        "command": "syn3.setColumns.1",
        "title": "1 Column",
        "category": "SGroup"
      },
      {
        "command": "syn3.setColumns.2",
        "title": "2 Columns",
        "category": "SGroup"
      },
      {
        "command": "syn3.setColumns.3",
        "title": "3 Columns",
        "category": "SGroup"
      },
      {
        "command": "syn3.createSubgroup",
        "title": "New Subgroup…",
        "category": "SGroup",
        "icon": "$(new-folder)"
      },
      {
        "command": "syn3.unnestMarker",
        "title": "Move Up a Level",
        "category": "SGroup",
        "icon": "$(arrow-up)"
      }
    ],
    "submenus": [
      {
        "id": "syn3.columns",
        "label": "Columns"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "syn3.assign",
          "group": "7_modification@90"
        },
        {
          "command": "syn3.markClassManual",
          "when": "!explorerResourceIsFolder",
          "group": "7_modification@90.5"
        },
        {
          "command": "syn3.unassignFromExplorer",
          "group": "7_modification@91"
        }
      ],
      "editor/context": [
        {
          "command": "syn3.markClass",
          "group": "7_modification@90"
        }
      ],
      "view/title": [
        {
          "command": "syn3.historyBack",
          "when": "view == syn3Map || view == syn3MapBottom",
          "group": "navigation@-2"
        },
        {
          "command": "syn3.historyForward",
          "when": "view == syn3Map || view == syn3MapBottom",
          "group": "navigation@-1"
        },
        {
          "command": "syn3.refresh",
          "when": "view == syn3Map || view == syn3MapBottom",
          "group": "more@1"
        },
        {
          "command": "syn3.openConfig",
          "when": "view == syn3Map || view == syn3MapBottom",
          "group": "more@2"
        },
        {
          "command": "syn3.openSettings",
          "when": "view == syn3Map || view == syn3MapBottom",
          "group": "more@3"
        },
        {
          "command": "syn3.map.toggleLayout",
          "when": "view == syn3Map || view == syn3MapBottom",
          "group": "navigation@0"
        },
        {
          "command": "syn3.createMarker",
          "when": "view == syn3Map || view == syn3MapBottom",
          "group": "navigation@2"
        },
        {
          "command": "syn3.map.collapseGroups",
          "when": "(view == syn3Map || view == syn3MapBottom) && !syn3.map.topCollapsed",
          "group": "navigation@3"
        },
        {
          "command": "syn3.map.expandGroups",
          "when": "(view == syn3Map || view == syn3MapBottom) && syn3.map.topCollapsed",
          "group": "navigation@3"
        },
        {
          "command": "syn3.map.openBottom",
          "when": "view == syn3Map",
          "group": "navigation@8"
        },
        {
          "command": "syn3.map.toggleColumn",
          "when": "view == syn3Map",
          "group": "navigation@9"
        },
        {
          "command": "syn3.map.toggleRight",
          "when": "view == syn3Map",
          "group": "navigation@10"
        },
        {
          "command": "syn3.map.groups.flow",
          "when": "(view == syn3Map || view == syn3MapBottom) && (syn3.map.groupsLayout == flow || !syn3.map.groupsLayout)",
          "group": "navigation@1"
        },
        {
          "command": "syn3.map.groups.1",
          "when": "(view == syn3Map || view == syn3MapBottom) && syn3.map.groupsLayout == 1",
          "group": "navigation@1"
        },
        {
          "command": "syn3.map.groups.2",
          "when": "(view == syn3Map || view == syn3MapBottom) && syn3.map.groupsLayout == 2",
          "group": "navigation@1"
        },
        {
          "command": "syn3.map.groups.3",
          "when": "(view == syn3Map || view == syn3MapBottom) && syn3.map.groupsLayout == 3",
          "group": "navigation@1"
        }
      ],
      "webview/context": [
        {
          "command": "syn3.reveal",
          "when": "webviewId =~ /^syn3Map(Panel|Bottom)?$/ && webviewSection == 'item'",
          "group": "navigation@1"
        },
        {
          "command": "syn3.openClass",
          "when": "webviewId =~ /^syn3Map(Panel|Bottom)?$/ && webviewSection == 'class'",
          "group": "navigation@1"
        },
        {
          "command": "syn3.reveal",
          "when": "webviewId =~ /^syn3Map(Panel|Bottom)?$/ && webviewSection == 'class'",
          "group": "navigation@2"
        },
        {
          "command": "syn3.openItem",
          "when": "webviewId =~ /^syn3Map(Panel|Bottom)?$/ && webviewSection == 'marker'",
          "group": "navigation@1"
        },
        {
          "command": "syn3.openFull",
          "when": "webviewId =~ /^syn3Map(Panel|Bottom)?$/ && webviewSection == 'marker'",
          "group": "navigation@2"
        },
        {
          "command": "syn3.openItem",
          "when": "webviewId =~ /^syn3Map(Panel|Bottom)?$/ && webviewSection == 'item' && isDir",
          "group": "navigation@2"
        },
        {
          "command": "syn3.openFull",
          "when": "webviewId =~ /^syn3Map(Panel|Bottom)?$/ && webviewSection == 'item' && isDir",
          "group": "navigation@3"
        },
        {
          "command": "syn3.rename",
          "when": "webviewId =~ /^syn3Map(Panel|Bottom)?$/ && webviewSection == 'item'",
          "group": "7_modification@1"
        },
        {
          "command": "syn3.setAlias",
          "when": "webviewId =~ /^syn3Map(Panel|Bottom)?$/ && webviewSection =~ /^(item|class|missingClass)$/",
          "group": "7_modification@1.5"
        },
        {
          "command": "syn3.clearAlias",
          "when": "webviewId =~ /^syn3Map(Panel|Bottom)?$/ && webviewSection =~ /^(item|class|missingClass)$/ && hasAlias",
          "group": "7_modification@1.6"
        },
        {
          "command": "syn3.relink",
          "when": "webviewId =~ /^syn3Map(Panel|Bottom)?$/ && webviewSection == 'missing'",
          "group": "7_modification@2"
        },
        {
          "command": "syn3.unassign",
          "when": "webviewId =~ /^syn3Map(Panel|Bottom)?$/ && webviewSection =~ /^(item|missing|class|missingClass)$/",
          "group": "7_modification@3"
        },
        {
          "command": "syn3.editMarker",
          "when": "webviewId =~ /^syn3Map(Panel|Bottom)?$/ && webviewSection == 'marker'",
          "group": "1_marker@1"
        },
        {
          "command": "syn3.setAlias",
          "when": "webviewId =~ /^syn3Map(Panel|Bottom)?$/ && webviewSection == 'marker'",
          "group": "1_marker@1.5"
        },
        {
          "command": "syn3.clearAlias",
          "when": "webviewId =~ /^syn3Map(Panel|Bottom)?$/ && webviewSection == 'marker' && hasAlias",
          "group": "1_marker@1.6"
        },
        {
          "command": "syn3.moveMarkerUp",
          "when": "webviewId =~ /^syn3Map(Panel|Bottom)?$/ && webviewSection == 'marker'",
          "group": "1_marker@6"
        },
        {
          "command": "syn3.moveMarkerDown",
          "when": "webviewId =~ /^syn3Map(Panel|Bottom)?$/ && webviewSection == 'marker'",
          "group": "1_marker@7"
        },
        {
          "command": "syn3.deleteMarker",
          "when": "webviewId =~ /^syn3Map(Panel|Bottom)?$/ && webviewSection == 'marker'",
          "group": "2_danger@1"
        },
        {
          "command": "syn3.changeColor",
          "when": "webviewId =~ /^syn3Map(Panel|Bottom)?$/ && webviewSection == 'marker'",
          "group": "1_marker@3"
        },
        {
          "command": "syn3.changeIcon",
          "when": "webviewId =~ /^syn3Map(Panel|Bottom)?$/ && webviewSection == 'marker'",
          "group": "1_marker@4"
        },
        {
          "submenu": "syn3.columns",
          "when": "webviewId =~ /^syn3Map(Panel|Bottom)?$/ && webviewSection == 'marker'",
          "group": "1_marker@5.5"
        },
        {
          "command": "syn3.createSubgroup",
          "when": "webviewId =~ /^syn3Map(Panel|Bottom)?$/ && webviewSection == 'marker' && depth < 2",
          "group": "1_marker@2"
        },
        {
          "command": "syn3.unnestMarker",
          "when": "webviewId =~ /^syn3Map(Panel|Bottom)?$/ && webviewSection == 'marker' && depth > 0",
          "group": "1_marker@8"
        }
      ],
      "syn3.columns": [
        {
          "command": "syn3.setColumns.flow",
          "group": "1_columns@1",
          "toggled": "columns == 'flow'"
        },
        {
          "command": "syn3.setColumns.1",
          "group": "1_columns@2",
          "toggled": "columns == '1'"
        },
        {
          "command": "syn3.setColumns.2",
          "group": "1_columns@3",
          "toggled": "columns == '2'"
        },
        {
          "command": "syn3.setColumns.3",
          "group": "1_columns@4",
          "toggled": "columns == '3'"
        }
      ],
      "commandPalette": [
        {
          "command": "syn3.unassign",
          "when": "false"
        },
        {
          "command": "syn3.unassignFromExplorer",
          "when": "false"
        },
        {
          "command": "syn3.rename",
          "when": "false"
        },
        {
          "command": "syn3.reveal",
          "when": "false"
        },
        {
          "command": "syn3.relink",
          "when": "false"
        },
        {
          "command": "syn3.editMarker",
          "when": "false"
        },
        {
          "command": "syn3.deleteMarker",
          "when": "false"
        },
        {
          "command": "syn3.moveMarkerUp",
          "when": "false"
        },
        {
          "command": "syn3.moveMarkerDown",
          "when": "false"
        },
        {
          "command": "syn3.changeColor",
          "when": "false"
        },
        {
          "command": "syn3.changeIcon",
          "when": "false"
        },
        {
          "command": "syn3.map.groups.flow",
          "when": "false"
        },
        {
          "command": "syn3.map.groups.1",
          "when": "false"
        },
        {
          "command": "syn3.map.groups.2",
          "when": "false"
        },
        {
          "command": "syn3.map.groups.3",
          "when": "false"
        },
        {
          "command": "syn3.map.collapseGroups",
          "when": "false"
        },
        {
          "command": "syn3.map.expandGroups",
          "when": "false"
        },
        {
          "command": "syn3.setColumns.flow",
          "when": "false"
        },
        {
          "command": "syn3.setColumns.1",
          "when": "false"
        },
        {
          "command": "syn3.setColumns.2",
          "when": "false"
        },
        {
          "command": "syn3.setColumns.3",
          "when": "false"
        },
        {
          "command": "syn3.createSubgroup",
          "when": "false"
        },
        {
          "command": "syn3.unnestMarker",
          "when": "false"
        },
        {
          "command": "syn3.setAlias",
          "when": "false"
        },
        {
          "command": "syn3.clearAlias",
          "when": "false"
        },
        {
          "command": "syn3.openClass",
          "when": "false"
        },
        {
          "command": "syn3.openItem",
          "when": "false"
        },
        {
          "command": "syn3.openFull",
          "when": "false"
        },
        {
          "command": "syn3.markClassManual",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "syn3.historyBack",
          "when": "activeWebviewPanelId == 'syn3MapPanel'",
          "group": "navigation@-2"
        },
        {
          "command": "syn3.historyForward",
          "when": "activeWebviewPanelId == 'syn3MapPanel'",
          "group": "navigation@-1"
        },
        {
          "command": "syn3.refresh",
          "when": "activeWebviewPanelId == 'syn3MapPanel'",
          "group": "more@1"
        },
        {
          "command": "syn3.openConfig",
          "when": "activeWebviewPanelId == 'syn3MapPanel'",
          "group": "more@2"
        },
        {
          "command": "syn3.openSettings",
          "when": "activeWebviewPanelId == 'syn3MapPanel'",
          "group": "more@3"
        },
        {
          "command": "syn3.map.toggleLayout",
          "when": "activeWebviewPanelId == 'syn3MapPanel'",
          "group": "navigation@0"
        },
        {
          "command": "syn3.createMarker",
          "when": "activeWebviewPanelId == 'syn3MapPanel'",
          "group": "navigation@2"
        },
        {
          "command": "syn3.map.collapseGroups",
          "when": "activeWebviewPanelId == 'syn3MapPanel' && !syn3.map.topCollapsed",
          "group": "navigation@3"
        },
        {
          "command": "syn3.map.expandGroups",
          "when": "activeWebviewPanelId == 'syn3MapPanel' && syn3.map.topCollapsed",
          "group": "navigation@3"
        },
        {
          "command": "syn3.map.groups.flow",
          "when": "activeWebviewPanelId == 'syn3MapPanel' && (syn3.map.groupsLayout == flow || !syn3.map.groupsLayout)",
          "group": "navigation@1"
        },
        {
          "command": "syn3.map.groups.1",
          "when": "activeWebviewPanelId == 'syn3MapPanel' && syn3.map.groupsLayout == 1",
          "group": "navigation@1"
        },
        {
          "command": "syn3.map.groups.2",
          "when": "activeWebviewPanelId == 'syn3MapPanel' && syn3.map.groupsLayout == 2",
          "group": "navigation@1"
        },
        {
          "command": "syn3.map.groups.3",
          "when": "activeWebviewPanelId == 'syn3MapPanel' && syn3.map.groupsLayout == 3",
          "group": "navigation@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "syn3.historyBack",
        "key": "alt+left",
        "when": "focusedView == syn3Map || focusedView == syn3MapBottom || activeWebviewPanelId == syn3MapPanel"
      },
      {
